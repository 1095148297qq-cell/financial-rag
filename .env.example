# api_key is the portable default; never put real credentials in this template.
AUTH_MODE=api_key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# No automatic paid fallback. Local call budget is persisted across restarts.
MAX_MODEL_CALLS=80
