# api_key is the portable default; never put real credentials in this template.
AUTH_MODE=api_key
API_PROVIDER=openai
OPENAI_API_KEY=
# For other providers, change API_PROVIDER and fill only the corresponding key.
# API_PROVIDER values: openai / deepseek / qwen / siliconflow
# DEEPSEEK_API_KEY=
# qwen requires a Beijing-region key:
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Blank selects the provider's default model; OAuth uses the available catalog.
CHAT_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# No automatic paid fallback. Local call budget is persisted across restarts.
MAX_MODEL_CALLS=80
